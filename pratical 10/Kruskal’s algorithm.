
#include <iostream>
#include <algorithm>
using namespace std;

struct Edge {
    int src, dest, weight;
};

int parent[100];

int find(int i) {
    if (parent[i] == i)
        return i;

    return parent[i] = find(parent[i]);
}

void unionSet(int u, int v) {
    parent[u] = v;
}

bool compare(Edge a, Edge b) {
    return a.weight < b.weight;
}

int main() {
    int V, E;

    cout << "Enter number of vertices: ";
    cin >> V;

    cout << "Enter number of edges: ";
    cin >> E;

    Edge edges[100];

    cout << "Enter source, destination and weight:\n";

    for (int i = 0; i < E; i++) {
        cin >> edges[i].src
            >> edges[i].dest
            >> edges[i].weight;
    }

    sort(edges, edges + E, compare);

    for (int i = 0; i < V; i++) {
        parent[i] = i;
    }

    int totalCost = 0;
    int count = 0;

    cout << "\nEdges in Minimum Spanning Tree:\n";

    for (int i = 0; i < E && count < V - 1; i++) {
        int u = find(edges[i].src);
        int v = find(edges[i].dest);

        if (u != v) {
            cout << edges[i].src << " - "
                 << edges[i].dest << " : "
                 << edges[i].weight << endl;

            unionSet(u, v);

            totalCost += edges[i].weight;
            count++;
        }
    }

    if (count != V - 1) {
        cout << "MST does not exist. Graph is disconnected.\n";
    } else {
        cout << "\nMinimum Cost = " << totalCost << endl;
    }

    return 0;
}
